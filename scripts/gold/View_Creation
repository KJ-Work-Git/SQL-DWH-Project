SELECT cst_key, COUNT(*) 
FROM(
SELECT
    ci.cst_id, 
    ci.cst_key, 
    ci.cst_firstname, 
    ci.cst_lastname, 
    ci.cst_marital_status, 
    ci.cst_gndr,
    ci.cst_create_date,
    ca.bdate,
    loc.cntry
FROM silver.crm_cust_info ci
LEFT JOIN silver.erp_cust_az12 ca
ON ci.cst_key = ca.cid
LEFT JOIN silver.erp_loc_a101 loc
ON ci.cst_key = loc.cid
)t
GROUP BY cst_key
HAVING COUNT(*) > 1; -- COUNT > 1 serves as Duplicate Check


SELECT DISTINCT 
    ci.cst_gndr,
    ca.gen,
    CASE WHEN ca.gen = 'n/a' THEN ci.cst_gndr -- CRM is the Master
    ELSE COALESCE(ca.gen, 'n/a')
    END AS new_gen
FROM silver.crm_cust_info ci
LEFT JOIN silver.erp_cust_az12 ca
ON ci.cst_key = ca.cid;

SELECT prd_key, COUNT(*) 
FROM (
SELECT
	prd.prd_id,
	prd.cat_id,
	prd.prd_key,
	prd.prd_nm,
	prd.prd_cost,
	prd.prd_line,
	cat.cat,
	cat.subcat,
	cat.maintenance,
	prd.prd_start_dt,
	prd.prd_end_dt,
	prd.dwh_create_date
FROM silver.crm_prd_info prd
LEFT JOIN silver.erp_px_cat_g1v2 cat
ON prd.cat_id = cat.id
WHERE prd_end_dt IS NULL -- Only show currently active orders
)t
GROUP BY prd_key
HAVING COUNT(*) > 1 -- Duplicate Check


-- Creation of Dim Tables

-- Dim Customers

CREATE VIEW gold.dim_customers AS
SELECT
	ROW_NUMBER() OVER(ORDER BY cst_id) AS customer_number,
    ci.cst_id AS customer_id,
    ci.cst_key AS customer_key, 
    ci.cst_firstname AS first_name, 
    ci.cst_lastname AS last_name, 
    ci.cst_marital_status AS marital_status,
    loc.cntry AS country,
    CASE WHEN ci.cst_gndr != 'n/a' THEN ci.cst_gndr
    ELSE COALESCE(ca.gen, 'n/a') 
    END AS gender,
    ca.bdate,
    ci.cst_create_date
FROM silver.crm_cust_info ci
LEFT JOIN silver.erp_cust_az12 ca
ON ci.cst_key = ca.cid
LEFT JOIN silver.erp_loc_a101 loc
ON ci.cst_key = loc.cid;


-- Dim Products


CREATE VIEW gold.dim_products AS
SELECT
	ROW_NUMBER() OVER(ORDER BY prd.prd_start_dt) AS product_number,
	prd.prd_id AS product_id,
	prd.prd_key AS product_key,
	prd.prd_nm AS product_name,
	prd.prd_cost AS cost,
	prd.prd_line AS product_line,
	prd.cat_id AS category_id,
	cat.cat AS category,
	cat.subcat AS subcategory,
	cat.maintenance,
	prd.prd_start_dt AS start_date,
	prd.prd_end_dt AS end_date,
	prd.dwh_create_date
FROM silver.crm_prd_info prd
LEFT JOIN silver.erp_px_cat_g1v2 cat
ON prd.cat_id = cat.id
WHERE prd_end_dt IS NULL; -- Only show currently active orders


-- Fact Sales

CREATE VIEW gold.fact_sales AS
SELECT
	sls.sls_ord_num AS order_number,
	sls.sls_prd_key AS product_key,
	sls.sls_cust_id AS customer_key,
	sls.sls_order_dt AS order_date,
	sls.sls_ship_dt AS ship_date,
	sls.sls_due_dt AS due_date,
	sls.sls_sales AS sales_made,
	sls.sls_quantity AS quantity,
	sls.sls_price AS price
FROM silver.crm_sales_details sls
LEFT JOIN gold.dim_products pr
ON sls.sls_prd_key = pr.product_key
LEFT JOIN gold.dim_customers cu
ON sls.sls_cust_id = cu.customer_id;


-- Foreign Key Checks

SELECT *
FROM gold.fact_sales f
LEFT JOIN gold.dim_customers c
ON c.customer_key = f.customer_key
LEFT JOIN gold.dim_products p
ON p.product_key = f.product_key
WHERE c.customer_key IS NULL;


